pkgname=bettercalc
pkgver=0.1.0
pkgrel=1
pkgdesc='Basic, scientific and programmer calculator that follows the Omarchy theme'
arch=('x86_64' 'aarch64')
license=('MIT' 'OFL-1.1')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/bettercalc "$pkgdir/usr/bin/bettercalc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 "$startdir/bettercalc.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/bettercalc.svg"
  install -Dm644 "$startdir/bettercalc.desktop" "$pkgdir/usr/share/applications/bettercalc.desktop"
}
